desc: StripLink Aggregator v2.0
options:gmem=striplink_v2.0

num_inputs = 14; 
num_outputs = 2;

slider1:0<0,1000,1>-Assigned Slot 
slider2:0<0,3,1{AUTO DETECT,COMPRESOR,GATE/EXPANDER,UPWARD EXPANDER}>Detection Mode DYN meter 1
slider3:0<0,3,1{AUTO DETECT,COMPRESOR,GATE/EXPANDER,UPWARD EXPANDER}>Detection Mode DYN meter 2

@init
ext_noinit = 1; // Prevent full reset on transport play/stop

// ============================================================================
// BUCKET & VELOCITY ENGINE PARAMETERS
// ============================================================================
cfg_bucket_target_ms   = 15;    // Target stable duration to fill bucket (ms)
cfg_rel_floor_db       = 35;    // Dynamic floor distance below track peak (dB)
cfg_abs_min_vol        = -85;   // Hard absolute minimum floor threshold (dB)
cfg_step_weight        = 0.30;    // MUG Adaptation Step (0.05 - 1.0)
cfg_vel_time_ms        = 35;    // Velocity EMA Memory / Integration Window (20-50ms)

m1_gate_env_out = 0;
m2_gate_env_out = 0;

// --- DSP SMOOTHING COEFFICIENTS ---
s_rate = (srate > 0) ? srate : 48000;

// DECIMACIJA (Nove spremenljivke)
dec_factor = 16;
s_rate_dsp = s_rate / dec_factor;  // Efektivni sample rate za KINK in logaritme (cca 3000 Hz)
fps_ui = 60;                       // Osveževanje balistike in UI pri 60 Hz
dec_ui_target = floor(s_rate / fps_ui);

GATE_bucket_size = max(1, floor(100 * (s_rate_dsp / (48000/16))));

// --- METER BALLISTICS & TEXT REFRESH TIMERS (Prilagojeno na fps_ui) ---
gr_decay = exp(-1.0 / (fps_ui * 0.5));
gate_fall_time_ms = 20.0; // closing time
gate_fall_coeff = 1 - exp(-1.0 / (fps_ui * (gate_fall_time_ms / 1000.0)));

gate_rise_time_ms = 20.0; // opening time
gate_rise_coeff = 1.0 - exp(-1.0 / (fps_ui * (gate_rise_time_ms / 1000.0)));

grace_samples = floor(s_rate_dsp * 0.05);
fallback_samples = floor(s_rate_dsp * 0.1);
cfg_hide_text_db       = -45.0;  
cfg_hide_env_lin       = 10 ^ (cfg_hide_text_db / 20);

// Envelope follower smoothing (Ohrani na polni s_rate, ker se izvaja zunaj decimacijske zanke)
env_coeff = 1.0 - exp(-1.0 / (s_rate * 0.005));
gate_env_coeff = 1.0 - exp(-1.0 / (s_rate * 0.050));
rms_ema_coeff = 1.0 - exp(-1.0 / (s_rate * 0.300)); 

// Velocity in Peak Decay (Prilagojeno na decimacijo s_rate_dsp)
vel_coeff = 1.0 - exp(-1.0 / (s_rate_dsp * (cfg_vel_time_ms / 1000.0)));
peak_decay_coeff = 1.0 - exp(-1.0 / (s_rate_dsp * 3.0));

bucket_max = max(1, floor(s_rate_dsp * (cfg_bucket_target_ms / 1000.0))); // Compressor
bucket_max_exp = max(1, floor(s_rate_dsp * (45.0 / 1000.0)));             // Expander

// Meter 1 State Variables
m1_env_in = 0; m1_env_out = 0; m1_smooth_diff = 0; m1_last_smooth_diff = 0;
m1_inst_vel = 0; m1_vel = 0; m1_window_drift = 0;
m1_peak_in_db = -144; m1_dyn_min_vol = -85.0;
m1_bucket_level = 0; m1_bucket_state = 0; m1_captured_mug = 0; 
m1_latched = 0; m1_first_run = 0; m1_engine_mode = 0;
m1_disp = 0; m1_text_val = 0; m1_window_peak = 0; m1_all_time_max = 0; m1_txt_timer = 0;

// Meter 2 State Variables
m2_env_in = 0; m2_env_out = 0; m2_smooth_diff = 0; m2_last_smooth_diff = 0;
m2_inst_vel = 0; m2_vel = 0; m2_window_drift = 0;
m2_peak_in_db = -144; m2_dyn_min_vol = -85.0;
m2_bucket_level = 0; m2_bucket_state = 0; m2_captured_mug = 0; 
m2_latched = 0; m2_first_run = 0; m2_engine_mode = 0;
m2_disp = 0; m2_text_val = 0; m2_window_peak = 0; m2_all_time_max = 0; m2_txt_timer = 0;

// Meter 3 State Variables (Output Level)
m3_disp = 0; m3_text_val = -144; m3_window_peak = -144; m3_txt_timer = 0;

update_rate = floor(s_rate * .05);
update_cnt = 0; was_playing = 0;

text_refresh_fast = floor(s_rate * 0.05);  // fast refresh
text_refresh_slow = floor(s_rate * 0.20);  // slow refresh

// Meter 4 State Variables (Final Out Level 1/2)
m4_disp = 0;

// ==========================================================
// AUTO GAIN PARAMETERS (Adaptive Interpolation Method)
// ==========================================================
ag_booted == 0 ? (
    ag_current_gain = 1.0;
    ag_target_gain = 1.0;
    ag_ref_power_env = 0.0;
    ag_out_power_env = 0.0;
    ag_initialized = 0;
    ag_fast_env = 0.0; // Fast envelope for independent silence detection
    ag_booted = 1;
);

ag_ema_time_ms = 150.0; // window for stable LUFS measurement
ag_ema_coeff = 1.0 - exp(-1.0 / (s_rate * (ag_ema_time_ms / 1000.0)));

// --- Pre-calculate smoothing limits for CPU efficiency ---
ag_time_slow_ms = 600.0; // Very slow transition when perfectly matched
ag_time_fast_ms = 40.0;  //  Fast transition when user changes gain drastically

ag_coeff_slow = 1.0 - exp(-1.0 / (s_rate * (ag_time_slow_ms / 1000.0)));
ag_coeff_fast = 1.0 - exp(-1.0 / (s_rate * (ag_time_fast_ms / 1000.0)));

ag_pi = 3.141592653589793;

// --- Absolute silence gate (ITU-R BS.1770 -70 LUFS) ---
ag_gate_lufs = -70.0;
ag_gate_power = 10 ^ ((ag_gate_lufs + 0.691) / 10.0);

// ==========================================================
// AUTO GAIN F-M WEIGHTING FILTER COEFFICIENTS (ISO 226)
// ==========================================================
ag_pi = 3.141592653589793;

// --- BAND 1: High Pass Filter (135 Hz, BW 2.5) ---
f0_1 = 135.0; bw_1 = 2.5;
w0_1 = 2.0 * ag_pi * f0_1 / s_rate;
q_1 = sqrt(2 ^ bw_1) / ((2 ^ bw_1) - 1.0);
alpha_1 = sin(w0_1) / (2.0 * q_1);
a0_1 = 1.0 + alpha_1;
hp_b0 = ((1.0 + cos(w0_1)) / 2.0) / a0_1;
hp_b1 = -(1.0 + cos(w0_1)) / a0_1;
hp_b2 = ((1.0 + cos(w0_1)) / 2.0) / a0_1;
hp_a1 = (-2.0 * cos(w0_1)) / a0_1;
hp_a2 = (1.0 - alpha_1) / a0_1;

// --- BAND 2: Bell / Peaking EQ (1450 Hz, -4.0 dB, BW 0.75) ---
f0_2 = 1450.0; db_2 = -4.0; bw_2 = 0.75;
A_2 = 10 ^ (db_2 / 40.0);
w0_2 = 2.0 * ag_pi * f0_2 / s_rate;
q_2 = sqrt(2 ^ bw_2) / ((2 ^ bw_2) - 1.0);
alpha_2 = sin(w0_2) / (2.0 * q_2);
a0_2 = 1.0 + alpha_2 / A_2;
pk1_b0 = (1.0 + alpha_2 * A_2) / a0_2;
pk1_b1 = (-2.0 * cos(w0_2)) / a0_2;
pk1_b2 = (1.0 - alpha_2 * A_2) / a0_2;
pk1_a1 = (-2.0 * cos(w0_2)) / a0_2;
pk1_a2 = (1.0 - alpha_2 / A_2) / a0_2;

// --- BAND 3: Bell / Peaking EQ (3500 Hz, +5.5 dB, BW 1.15) ---
f0_3 = 3500.0; db_3 = 5.5; bw_3 = 1.15;
A_3 = 10 ^ (db_3 / 40.0);
w0_3 = 2.0 * ag_pi * f0_3 / s_rate;
q_3 = sqrt(2 ^ bw_3) / ((2 ^ bw_3) - 1.0);
alpha_3 = sin(w0_3) / (2.0 * q_3);
a0_3 = 1.0 + alpha_3 / A_3;
pk2_b0 = (1.0 + alpha_3 * A_3) / a0_3;
pk2_b1 = (-2.0 * cos(w0_3)) / a0_3;
pk2_b2 = (1.0 - alpha_3 * A_3) / a0_3;
pk2_a1 = (-2.0 * cos(w0_3)) / a0_3;
pk2_a2 = (1.0 - alpha_3 / A_3) / a0_3;

// --- BAND 4: High Shelf (4700 Hz, -14.0 dB, BW 1.00) ---
f0_4 = 4700.0; db_4 = -14.0; bw_4 = 1.00;
A_4 = 10 ^ (db_4 / 40.0);
w0_4 = 2.0 * ag_pi * f0_4 / s_rate;
q_4 = sqrt(2 ^ bw_4) / ((2 ^ bw_4) - 1.0);
alpha_4 = sin(w0_4) / (2.0 * q_4);
a0_4 = (A_4 + 1.0) - (A_4 - 1.0) * cos(w0_4) + 2.0 * sqrt(A_4) * alpha_4;
hs_b0 = (A_4 * ((A_4 + 1.0) + (A_4 - 1.0) * cos(w0_4) + 2.0 * sqrt(A_4) * alpha_4)) / a0_4;
hs_b1 = (-2.0 * A_4 * ((A_4 - 1.0) + (A_4 + 1.0) * cos(w0_4))) / a0_4;
hs_b2 = (A_4 * ((A_4 + 1.0) + (A_4 - 1.0) * cos(w0_4) - 2.0 * sqrt(A_4) * alpha_4)) / a0_4;
hs_a1 = (2.0 * ((A_4 - 1.0) - (A_4 + 1.0) * cos(w0_4))) / a0_4;
hs_a2 = ((A_4 + 1.0) - (A_4 - 1.0) * cos(w0_4) - 2.0 * sqrt(A_4) * alpha_4) / a0_4;


@block
tr_idx = get_host_placement(p, f);
(tr_idx >= 0) ? ( slider1 = tr_idx + 1; );

// --- PROFILE FOR METER 1 (COMP 1) ---
cfg_stability_tolerance_1 = 0.05;
diff_smooth_time_1 = 0.002; 
diff_smooth_coeff_1 = 1.0 - exp(-1.0 / (s_rate_dsp * diff_smooth_time_1));

// --- PROFILE FOR METER 2 (COMP 2) ---
cfg_stability_tolerance_2 = 0.05;
diff_smooth_time_2 = 0.002; 
diff_smooth_coeff_2 = 1.0 - exp(-1.0 / (s_rate_dsp * diff_smooth_time_2));

is_playing = play_state & 1;

// Reset states on transport start to ensure clean initial calibration
(is_playing && was_playing == 0) ? (
    m1_captured_mug = 0; m1_first_run = 0; m1_latched = 0; m1_bucket_level = 0; m1_kink_cnt = 0; m1_debug_accel = 0; m1_temp_mug = -144.0;
    
    m1_vel = 0; m1_last_smooth_diff = 0; m1_smooth_diff = 0; m1_env_in = 0; m1_env_out = 0; m1_peak_in_db = -144;
    m1_disp = 0; m1_text_val = 0; m1_all_time_max = 0; m1_txt_timer = 0; m1_window_peak = 0;
    
    m2_captured_mug = 0; m2_first_run = 0; m2_latched = 0; m2_bucket_level = 0; m2_kink_cnt = 0; m2_debug_accel = 0; m2_temp_mug = -144.0;
    
    m2_vel = 0; m2_last_smooth_diff = 0; m2_smooth_diff = 0; m2_env_in = 0; m2_env_out = 0; m2_peak_in_db = -144;
    m2_disp = 0; m2_text_val = 0; m2_all_time_max = 0; m2_txt_timer = 0; m2_window_peak = 0;
    
    m3_disp = 0; m3_text_val = -144; m3_txt_timer = 0; m3_window_peak = -144;
    
    m4_disp = 0;
);
was_playing = is_playing;

@sample 
spl0 = spl0 + 0.000000000000001; 
spl1 = spl1;

p_base = gmem[100000];
local_base = p_base + slider1 * 500;

// ==========================================================
// ENVELOPES
// ==========================================================
// Meter 1 Envelopes (Channels 5/6 and 7/8)
m1_pre_raw  = max(abs(spl4), abs(spl5));
m1_pre_raw = (m1_pre_raw >= 0 && m1_pre_raw < 100) ? m1_pre_raw : 0;
m1_env_in += (m1_pre_raw - m1_env_in) * env_coeff;

m1_post_raw = max(abs(spl6), abs(spl7));
m1_post_raw = (m1_post_raw >= 0 && m1_post_raw < 100) ? m1_post_raw : 0;
m1_env_out += (m1_post_raw - m1_env_out) * env_coeff;
m1_gate_env_out += (m1_post_raw - m1_gate_env_out) * gate_env_coeff;

// Meter 2 Envelopes (Channels 9/10 and 11/12)
m2_pre_raw  = max(abs(spl8), abs(spl9));
m2_pre_raw = (m2_pre_raw >= 0 && m2_pre_raw < 100) ? m2_pre_raw : 0;
m2_env_in += (m2_pre_raw - m2_env_in) * env_coeff;

m2_post_raw = max(abs(spl10), abs(spl11));
m2_post_raw = (m2_post_raw >= 0 && m2_post_raw < 100) ? m2_post_raw : 0;
m2_env_out += (m2_post_raw - m2_env_out) * env_coeff;
m2_gate_env_out += (m2_post_raw - m2_gate_env_out) * gate_env_coeff;


// =========================================================
// DECIMATION LOOP ZANKA(
// =========================================================
dec_cnt_dsp += 1;
(dec_cnt_dsp >= dec_factor) ? (
    dec_cnt_dsp = 0;
    
    lua_raw_1 = gmem[local_base + 330]; 
    lua_raw_2 = gmem[local_base + 331];
    
    // --- LINKED FX DETECTION (Serijski način za kompenzacijo Gate-a) ---
    m1_fx_id = gmem[local_base + 340];
    m2_fx_id = gmem[local_base + 341];
    is_linked_fx = (m1_fx_id > 0 && m1_fx_id == m2_fx_id); // Oba metra gledata isti vtičnik
    is_m1_native = (lua_raw_1 > 0.001 && (slider2 == 0 || slider2 == 1));
    is_m2_native = (lua_raw_2 > 0.001 && (slider3 == 0 || slider3 == 1));

    kink_mul = (dec_factor * dec_factor); // Kompenzacija pospeška na decimacijo

    // -----------------------------------------------------
    // DSP METER 1
    // -----------------------------------------------------
    (m1_env_in > 0.000001 && m1_env_in < 100) ? (
        m1_in_db = 20 * log10(m1_env_in);
        m1_out_db = (m1_env_out > 0.000001) ? 20 * log10(m1_env_out) : -144;

        (m1_in_db > m1_peak_in_db) ? m1_peak_in_db = m1_in_db : m1_peak_in_db += (m1_in_db - m1_peak_in_db) * peak_decay_coeff;
        m1_dyn_min_vol = max(cfg_abs_min_vol, m1_peak_in_db - cfg_rel_floor_db);

        m1_raw_diff = m1_out_db - m1_in_db;
        m1_smooth_diff += (m1_raw_diff - m1_smooth_diff) * diff_smooth_coeff_1;

        m1_inst_vel = abs(m1_smooth_diff - m1_last_smooth_diff) * s_rate_dsp; // UPORABLJA s_rate_dsp
        m1_last_smooth_diff = m1_smooth_diff;

        m1_vel += (m1_inst_vel - m1_vel) * vel_coeff;
        
        m1_vel_raw = m1_smooth_diff - m1_last_smooth_diff_kink;
        m1_last_smooth_diff_kink = m1_smooth_diff;
        m1_accel = m1_vel_raw - m1_last_vel_raw;
        m1_last_vel_raw = m1_vel_raw;
    ) : (
        m1_in_db = -144; m1_out_db = -144;
        m1_raw_diff = 0; m1_smooth_diff = 0; m1_last_smooth_diff = 0;
        m1_accel = 0; m1_vel_raw = 0; m1_last_vel_raw = 0;
    );

    // AUTO DETECT OBSERVER M1
    (m1_detected_mode == 0) ? m1_detected_mode = 1;
    m1_in_delta = m1_in_db - m1_last_in_db_obs;
    m1_last_in_db_obs = m1_in_db;

    obs1_kink_sens = 0.00001 * kink_mul * (48000 / s_rate); 
    obs1_kink = (abs(m1_accel) > obs1_kink_sens) && (m1_in_db > max(cfg_abs_min_vol, m1_peak_in_db - 30.0)) && (m1_in_delta > 0.1);

    (m1_obs_cooldown > 0) ? m1_obs_cooldown -= 1;
    (obs1_kink && m1_obs_timer <= 0 && m1_obs_cooldown <= 0 && m1_peak_in_db > -80) ? (
        m1_obs_timer = floor(s_rate_dsp * 0.030); 
        m1_obs_start_val = m1_raw_diff; 
    );
    (m1_obs_timer > 0) ? (
        m1_obs_timer -= 1;
        (m1_obs_timer == 0) ? (
            m1_obs_delta = m1_raw_diff - m1_obs_start_val; 
            (m1_gate_lockout <= 0) ? (
                (m1_obs_delta < -0.5) ? ( m1_vote_comp += 1; m1_vote_exp = 0; m1_vote_gate = 0; ) 
                : (m1_obs_delta > 0.5) ? ( m1_vote_exp += 1; m1_vote_comp = 0; m1_vote_gate = 0; );
            );
            m1_obs_cooldown = floor(s_rate_dsp * 0.100);
        );
    );

    // ZANESLJIVA GATE DETEKCIJA & ŠČIT M1
    (m1_gate_lockout > 0) ? m1_gate_lockout -= 1;
    gate1_cond = (m1_in_db < 0.0 && m1_smooth_diff < -30.0);
    (gate1_cond) ? ( 
        m1_gate_lockout = floor(s_rate_dsp * 1.5); 
        (m1_gate_cond_last == 0) ? ( m1_vote_gate = 3; m1_vote_comp = 0; m1_vote_exp = 0; );
    );
    m1_gate_cond_last = gate1_cond;
    m1_last_detected_mode = m1_detected_mode;
    (m1_vote_comp >= 3) ? ( m1_detected_mode = 1; m1_vote_comp = 0; );
    (m1_vote_gate >= 3) ? ( m1_detected_mode = 2; m1_vote_gate = 0; );
    (m1_vote_exp >= 3) ?  ( m1_detected_mode = 3; m1_vote_exp = 0; );

    (m1_detected_mode != m1_last_detected_mode) ? ( m1_first_run = 0; m1_temp_mug = -144.0; m1_bucket_level = 0; m1_captured_mug = 0; m1_kink_armed = 0; );
    m1_engine_mode = (slider2 == 0) ? m1_detected_mode : slider2;

    (m1_engine_mode != m1_last_engine_mode) ? (
        m1_first_run = 0; m1_temp_mug = -144.0; m1_bucket_level = 0; m1_captured_mug = 0; m1_kink_armed = 0; m1_disp = 0; m1_text_val = 0; m1_gate_peak = -144; m1_smooth_diff = 0; m1_last_smooth_diff = 0;
    );
    m1_last_engine_mode = m1_engine_mode;

    // ENGINE ROUTING M1
    is_m1_native ? (
        m1_gr_raw = max(0, lua_raw_1 - 1.0);
        m1_engine_mode = -1; 
    ) : (m1_engine_mode == 2) ? (
        (m1_in_db > -120) ? (
            // Kompenzacija kompresije (če je M2 kompresor na istem vtičniku)
            m1_comp_offset = (is_linked_fx && is_m2_native) ? max(0, lua_raw_2 - 1.0) : 0;
            m1_eff_raw = m1_raw_diff + m1_comp_offset;
            m1_eff_smooth = m1_smooth_diff + m1_comp_offset;

            (m1_in_db > m1_peak_in_db - 12.0) ? (
                (m1_gate_baseline <= -140.0) ? m1_gate_baseline = m1_eff_raw;
                (m1_eff_raw > m1_gate_baseline) ? m1_gate_baseline = m1_eff_raw : m1_gate_baseline += (m1_eff_raw - m1_gate_baseline) * 0.005;
            );
            m1_gr_raw = min(m1_eff_smooth - m1_gate_baseline, 0);
        ) : ( m1_gr_raw = 0; );
    ) : (
        (m1_in_db > -143) ? (
            (m1_engine_mode == 3) ? ( (m1_temp_mug <= -140.0) ? m1_temp_mug = m1_raw_diff : m1_temp_mug = min(m1_temp_mug, m1_raw_diff); ) 
            : ( m1_temp_mug = max(m1_temp_mug, m1_raw_diff); );
            
            m1_upper_safe_bound = (m1_engine_mode == 3) ? (m1_peak_in_db - 15.0) : (m1_peak_in_db - 25.0);
            m1_raw_diff_change = abs(m1_raw_diff - m1_last_raw_diff);
            m1_last_raw_diff = m1_raw_diff;
            m1_in_safe_zone = (m1_in_db < m1_upper_safe_bound && m1_in_db > cfg_abs_min_vol && m1_out_db > cfg_abs_min_vol);
            (m1_engine_mode != 3) ? ( m1_in_safe_zone = m1_in_safe_zone && ((m1_temp_mug - m1_raw_diff) < 4.0); );

            (m1_in_safe_zone) ? (
                (m1_engine_mode == 3 || m1_raw_diff_change < 0.02) ? (
                    m1_bucket_level += 1;
                    (m1_bucket_val <= -140.0) ? ( m1_bucket_val = m1_raw_diff; ) : (
                        (m1_engine_mode == 3) ? ( m1_bucket_val = min(m1_bucket_val, m1_raw_diff); ) : ( m1_bucket_val = max(m1_bucket_val, m1_raw_diff); );
                    );
                    (m1_engine_mode != 3 && m1_temp_mug > -140.0) ? ( m1_bucket_val = max(m1_bucket_val, m1_temp_mug); );
                ) : ( m1_bucket_level = 0; m1_bucket_val = -144.0; );
            ) : ( m1_bucket_level = 0; m1_bucket_val = -144.0; );
        ) : ( m1_bucket_state = 0; m1_bucket_level = 0; m1_temp_mug = -144.0; m1_bucket_val = -144.0; );

        m1_target_bucket = (m1_engine_mode == 3) ? bucket_max_exp : bucket_max;
        m1_bucket_level = max(0, min(m1_bucket_level, m1_target_bucket));
        (m1_bucket_level == m1_target_bucket) ? ( m1_kink_armed = 1; (m1_bucket_val > -140.0) ? m1_baseline_mug = m1_bucket_val; );

        kink_sens = -0.00001 * kink_mul * (48000 / s_rate); 
        kink_min_in_db = max(cfg_abs_min_vol, m1_peak_in_db - 30.0);
        (m1_engine_mode == 3) ? ( m1_kink_detected = (m1_accel > abs(kink_sens)) && (m1_in_db > kink_min_in_db); ) 
        : ( m1_kink_detected = (m1_accel < kink_sens) && (m1_in_db > kink_min_in_db); );

        m1_is_cold_start = (m1_first_run == 0);
        (m1_kink_detected && (m1_is_cold_start || m1_kink_armed == 1)) ? (
            m1_ui_flash = floor(s_rate_dsp * 0.5);
            (m1_is_cold_start) ? ( m1_captured_mug = m1_temp_mug; m1_first_run = 1; ) 
            : (m1_engine_mode == 3) ? ( (m1_baseline_mug < m1_captured_mug) ? m1_captured_mug += (m1_baseline_mug - m1_captured_mug) * 0.50 : m1_captured_mug += (m1_baseline_mug - m1_captured_mug) * 0.05; ) 
            : ( (m1_baseline_mug > m1_captured_mug) ? m1_captured_mug += (m1_baseline_mug - m1_captured_mug) * 0.50 : m1_captured_mug += (m1_baseline_mug - m1_captured_mug) * 0.05; );
            m1_kink_armed = 0; m1_bucket_level = 0; m1_latched = 1; m1_temp_mug = -144.0;
        );
        (m1_bucket_level < bucket_max && m1_kink_armed == 0) ? m1_latched = 0;
        (m1_ui_flash > 0) ? m1_ui_flash -= 1;
        
        (m1_engine_mode == 3) ? ( m1_gr_raw = (m1_first_run) ? min(m1_captured_mug - m1_smooth_diff, 0) : 0; ) 
        : ( m1_gr_raw = (m1_first_run) ? max(m1_captured_mug - m1_smooth_diff, 0) : 0; );
        (m1_in_db < -90 || m1_out_db < -110) ? m1_gr_raw = 0;
    );

    // -----------------------------------------------------
    // DSP METER 2
    // -----------------------------------------------------
    (m2_env_in > 0.000001 && m2_env_in < 100) ? (
        m2_in_db = 20 * log10(m2_env_in);
        m2_out_db = (m2_env_out > 0.000001) ? 20 * log10(m2_env_out) : -144;

        (m2_in_db > m2_peak_in_db) ? m2_peak_in_db = m2_in_db : m2_peak_in_db += (m2_in_db - m2_peak_in_db) * peak_decay_coeff;
        m2_dyn_min_vol = max(cfg_abs_min_vol, m2_peak_in_db - cfg_rel_floor_db);

        m2_raw_diff = m2_out_db - m2_in_db;
        m2_smooth_diff += (m2_raw_diff - m2_smooth_diff) * diff_smooth_coeff_2;

        m2_inst_vel = abs(m2_smooth_diff - m2_last_smooth_diff) * s_rate_dsp;
        m2_last_smooth_diff = m2_smooth_diff;

        m2_vel += (m2_inst_vel - m2_vel) * vel_coeff;
        
        m2_vel_raw = m2_smooth_diff - m2_last_smooth_diff_kink;
        m2_last_smooth_diff_kink = m2_smooth_diff;
        m2_accel = m2_vel_raw - m2_last_vel_raw;
        m2_last_vel_raw = m2_vel_raw;
    ) : (
        m2_in_db = -144; m2_out_db = -144;
        m2_raw_diff = 0; m2_smooth_diff = 0; m2_last_smooth_diff = 0;
        m2_accel = 0; m2_vel_raw = 0; m2_last_vel_raw = 0;
    );

    // AUTO DETECT OBSERVER M2
    (m2_detected_mode == 0) ? m2_detected_mode = 1;
    m2_in_delta = m2_in_db - m2_last_in_db_obs;
    m2_last_in_db_obs = m2_in_db;

    obs2_kink_sens = 0.00001 * kink_mul * (48000 / s_rate); 
    obs2_kink = (abs(m2_accel) > obs2_kink_sens) && (m2_in_db > max(cfg_abs_min_vol, m2_peak_in_db - 30.0)) && (m2_in_delta > 0.1);

    (m2_obs_cooldown > 0) ? m2_obs_cooldown -= 1;
    (obs2_kink && m2_obs_timer <= 0 && m2_obs_cooldown <= 0 && m2_peak_in_db > -80) ? (
        m2_obs_timer = floor(s_rate_dsp * 0.030); 
        m2_obs_start_val = m2_raw_diff; 
    );
    (m2_obs_timer > 0) ? (
        m2_obs_timer -= 1;
        (m2_obs_timer == 0) ? (
            m2_obs_delta = m2_raw_diff - m2_obs_start_val; 
            (m2_gate_lockout <= 0) ? (
                (m2_obs_delta < -0.5) ? ( m2_vote_comp += 1; m2_vote_exp = 0; m2_vote_gate = 0; ) 
                : (m2_obs_delta > 0.5) ? ( m2_vote_exp += 1; m2_vote_comp = 0; m2_vote_gate = 0; );
            );
            m2_obs_cooldown = floor(s_rate_dsp * 0.100);
        );
    );

    // ZANESLJIVA GATE DETEKCIJA & ŠČIT M2
    (m2_gate_lockout > 0) ? m2_gate_lockout -= 1;
    gate2_cond = (m2_in_db < 0.0 && m2_smooth_diff < -30.0);
    (gate2_cond) ? ( 
        m2_gate_lockout = floor(s_rate_dsp * 1.5); 
        (m2_gate_cond_last == 0) ? ( m2_vote_gate = 3; m2_vote_comp = 0; m2_vote_exp = 0; );
    );
    m2_gate_cond_last = gate2_cond;
    m2_last_detected_mode = m2_detected_mode;
    (m2_vote_comp >= 3) ? ( m2_detected_mode = 1; m2_vote_comp = 0; );
    (m2_vote_gate >= 3) ? ( m2_detected_mode = 2; m2_vote_gate = 0; );
    (m2_vote_exp >= 3) ?  ( m2_detected_mode = 3; m2_vote_exp = 0; );

    (m2_detected_mode != m2_last_detected_mode) ? ( m2_first_run = 0; m2_temp_mug = -144.0; m2_bucket_level = 0; m2_captured_mug = 0; m2_kink_armed = 0; );
    m2_engine_mode = (slider3 == 0) ? m2_detected_mode : slider3;

    (m2_engine_mode != m2_last_engine_mode) ? (
        m2_first_run = 0; m2_temp_mug = -144.0; m2_bucket_level = 0; m2_captured_mug = 0; m2_kink_armed = 0; m2_disp = 0; m2_text_val = 0; m2_gate_peak = -144; m2_smooth_diff = 0; m2_last_smooth_diff = 0;
    );
    m2_last_engine_mode = m2_engine_mode;

    // ENGINE ROUTING M2
    is_m2_native ? (
        m2_gr_raw = max(0, lua_raw_2 - 1.0);
        m2_engine_mode = -1; 
    ) : (m2_engine_mode == 2) ? (
        (m2_in_db > -120) ? (
            // Kompenzacija kompresije (če je M1 kompresor na istem vtičniku)
            m2_comp_offset = (is_linked_fx && is_m1_native) ? max(0, lua_raw_1 - 1.0) : 0;
            m2_eff_raw = m2_raw_diff + m2_comp_offset;
            m2_eff_smooth = m2_smooth_diff + m2_comp_offset;

            (m2_in_db > m2_peak_in_db - 12.0) ? (
                (m2_gate_baseline <= -140.0) ? m2_gate_baseline = m2_eff_raw;
                (m2_eff_raw > m2_gate_baseline) ? m2_gate_baseline = m2_eff_raw : m2_gate_baseline += (m2_eff_raw - m2_gate_baseline) * 0.005;
            );
            m2_gr_raw = min(m2_eff_smooth - m2_gate_baseline, 0);
        ) : ( m2_gr_raw = 0; );
    ) : (
        (m2_in_db > -143) ? (
            (m2_engine_mode == 3) ? ( (m2_temp_mug <= -140.0) ? m2_temp_mug = m2_raw_diff : m2_temp_mug = min(m2_temp_mug, m2_raw_diff); ) 
            : ( m2_temp_mug = max(m2_temp_mug, m2_raw_diff); );
            
            m2_upper_safe_bound = (m2_engine_mode == 3) ? (m2_peak_in_db - 15.0) : (m2_peak_in_db - 25.0);
            m2_raw_diff_change = abs(m2_raw_diff - m2_last_raw_diff);
            m2_last_raw_diff = m2_raw_diff;
            m2_in_safe_zone = (m2_in_db < m2_upper_safe_bound && m2_in_db > cfg_abs_min_vol && m2_out_db > cfg_abs_min_vol);
            (m2_engine_mode != 3) ? ( m2_in_safe_zone = m2_in_safe_zone && ((m2_temp_mug - m2_raw_diff) < 4.0); );

            (m2_in_safe_zone) ? (
                (m2_engine_mode == 3 || m2_raw_diff_change < 0.02) ? (
                    m2_bucket_level += 1;
                    (m2_bucket_val <= -140.0) ? ( m2_bucket_val = m2_raw_diff; ) : (
                        (m2_engine_mode == 3) ? ( m2_bucket_val = min(m2_bucket_val, m2_raw_diff); ) : ( m2_bucket_val = max(m2_bucket_val, m2_raw_diff); );
                    );
                    (m2_engine_mode != 3 && m2_temp_mug > -140.0) ? ( m2_bucket_val = max(m2_bucket_val, m2_temp_mug); );
                ) : ( m2_bucket_level = 0; m2_bucket_val = -144.0; );
            ) : ( m2_bucket_level = 0; m2_bucket_val = -144.0; );
        ) : ( m2_bucket_state = 0; m2_bucket_level = 0; m2_temp_mug = -144.0; m2_bucket_val = -144.0; );

        m2_target_bucket = (m2_engine_mode == 3) ? bucket_max_exp : bucket_max;
        m2_bucket_level = max(0, min(m2_bucket_level, m2_target_bucket));
        (m2_bucket_level == m2_target_bucket) ? ( m2_kink_armed = 1; (m2_bucket_val > -140.0) ? m2_baseline_mug = m2_bucket_val; );

        kink_sens_2 = -0.00001 * kink_mul * (48000 / s_rate); 
        kink_min_in_db_2 = max(cfg_abs_min_vol, m2_peak_in_db - 30.0);
        (m2_engine_mode == 3) ? ( m2_kink_detected = (m2_accel > abs(kink_sens_2)) && (m2_in_db > kink_min_in_db_2); ) 
        : ( m2_kink_detected = (m2_accel < kink_sens_2) && (m2_in_db > kink_min_in_db_2); );

        m2_is_cold_start = (m2_first_run == 0);
        (m2_kink_detected && (m2_is_cold_start || m2_kink_armed == 1)) ? (
            m2_ui_flash = floor(s_rate_dsp * 0.5);
            (m2_is_cold_start) ? ( m2_captured_mug = m2_temp_mug; m2_first_run = 1; ) 
            : (m2_engine_mode == 3) ? ( (m2_baseline_mug < m2_captured_mug) ? m2_captured_mug += (m2_baseline_mug - m2_captured_mug) * 0.50 : m2_captured_mug += (m2_baseline_mug - m2_captured_mug) * 0.05; ) 
            : ( (m2_baseline_mug > m2_captured_mug) ? m2_captured_mug += (m2_baseline_mug - m2_captured_mug) * 0.50 : m2_captured_mug += (m2_baseline_mug - m2_captured_mug) * 0.05; );
            m2_kink_armed = 0; m2_bucket_level = 0; m2_latched = 1; m2_temp_mug = -144.0;
        );
        (m2_bucket_level < bucket_max && m2_kink_armed == 0) ? m2_latched = 0;
        (m2_ui_flash > 0) ? m2_ui_flash -= 1;
        
        (m2_engine_mode == 3) ? ( m2_gr_raw = (m2_first_run) ? min(m2_captured_mug - m2_smooth_diff, 0) : 0; ) 
        : ( m2_gr_raw = (m2_first_run) ? max(m2_captured_mug - m2_smooth_diff, 0) : 0; );
        (m2_in_db < -90 || m2_out_db < -110) ? m2_gr_raw = 0;
    );
);


// =========================================================
// 3. DECIMACIJSKA ZANKA B: UI IN BALISTIKA (Izvaja se pri 60 Hz)
// =========================================================
dec_cnt_ui += 1;
(dec_cnt_ui >= dec_ui_target) ? (
    dec_cnt_ui = 0;

    // --- M1 BALLISTICS ---
    (m1_engine_mode == 2) ? (
        (m1_gr_raw > m1_disp) ? m1_disp += (m1_gr_raw - m1_disp) * gate_rise_coeff : m1_disp += (m1_gr_raw - m1_disp) * gate_fall_coeff;
        
        // PRAVA PEAK HOLD LOGIKA:
        (m1_disp < m1_text_val) ? (
            // Če je gate pritisnil globje, takoj osveži številko in resetiraj timer!
            m1_text_val = m1_disp;
            m1_gate_window_min = m1_disp;
            m1_txt_timer = floor(fps_ui * 0.5);
        ) : (
            // Beleži morebitno nižjo vrednost med čakanjem
            (m1_disp < m1_gate_window_min) ? m1_gate_window_min = m1_disp;
            
            // Odštevaj čas. Ko zmanjka, osveži številko
            m1_txt_timer -= 1;
            (m1_txt_timer <= 0) ? (
                m1_text_val = m1_gate_window_min;
                m1_gate_window_min = m1_disp;
                m1_txt_timer = floor(fps_ui * 0.5);
            );
        );
    ) : (m1_engine_mode == -1) ? (
        m1_gr_peak = max(-60, min(m1_gr_raw, 60)); 
        (abs(m1_gr_peak) > abs(m1_all_time_max)) ? m1_all_time_max = m1_gr_peak;
        (abs(m1_gr_peak) > abs(m1_disp)) ? m1_disp = m1_gr_peak : m1_disp *= gr_decay; 
        
        (abs(m1_gr_peak) > abs(m1_text_val)) ? ( m1_text_val = m1_gr_peak; m1_txt_timer = floor(fps_ui * 1.0); ) : (
            m1_txt_timer -= 1; (m1_txt_timer <= 0) ? ( m1_text_val = m1_gr_peak; m1_txt_timer = floor(fps_ui * 1.0); );
        );
    ) : (
        m1_gr_peak = max(-60, min(m1_gr_raw, 60)); 
        (abs(m1_gr_peak) > abs(m1_all_time_max)) ? m1_all_time_max = m1_gr_peak;
        (abs(m1_gr_peak) > abs(m1_disp)) ? m1_disp = m1_gr_peak : m1_disp *= gr_decay; 
        
        (abs(m1_gr_peak) > abs(m1_text_val)) ? ( m1_text_val = m1_gr_peak; m1_txt_timer = floor(fps_ui * 1.0); ) : (
            m1_txt_timer -= 1; (m1_txt_timer <= 0) ? ( m1_text_val = m1_gr_peak; m1_txt_timer = floor(fps_ui * 1.0); );
        );
    );

    (m1_env_in < cfg_hide_env_lin && m1_engine_mode != -1) ? (
        m1_silence_timer += 1;
        (m1_silence_timer > fps_ui * 0.5) ? ( (m1_engine_mode != 2) ? m1_text_val = 0; );
    ) : ( m1_silence_timer = 0; );

    // --- M2 BALLISTICS ---
    (m2_engine_mode == 2) ? (
        (m2_gr_raw > m2_disp) ? m2_disp += (m2_gr_raw - m2_disp) * gate_rise_coeff : m2_disp += (m2_gr_raw - m2_disp) * gate_fall_coeff;
        
        // PRAVA PEAK HOLD LOGIKA:
        (m2_disp < m2_text_val) ? (
            m2_text_val = m2_disp;
            m2_gate_window_min = m2_disp;
            m2_txt_timer = floor(fps_ui * 0.5);
        ) : (
            (m2_disp < m2_gate_window_min) ? m2_gate_window_min = m2_disp;
            
            m2_txt_timer -= 1;
            (m2_txt_timer <= 0) ? (
                m2_text_val = m2_gate_window_min;
                m2_gate_window_min = m2_disp;
                m2_txt_timer = floor(fps_ui * 0.5);
            );
        );
    ) : (m2_engine_mode == -1) ? (
        m2_gr_peak = max(-60, min(m2_gr_raw, 60)); 
        (abs(m2_gr_peak) > abs(m2_all_time_max)) ? m2_all_time_max = m2_gr_peak;
        (abs(m2_gr_peak) > abs(m2_disp)) ? m2_disp = m2_gr_peak : m2_disp *= gr_decay; 
        
        (abs(m2_gr_peak) > abs(m2_text_val)) ? ( m2_text_val = m2_gr_peak; m2_txt_timer = floor(fps_ui * 1.0); ) : (
            m2_txt_timer -= 1; (m2_txt_timer <= 0) ? ( m2_text_val = m2_gr_peak; m2_txt_timer = floor(fps_ui * 1.0); );
        );
    ) : (
        m2_gr_peak = max(-60, min(m2_gr_raw, 60)); 
        (abs(m2_gr_peak) > abs(m2_all_time_max)) ? m2_all_time_max = m2_gr_peak;
        (abs(m2_gr_peak) > abs(m2_disp)) ? m2_disp = m2_gr_peak : m2_disp *= gr_decay; 
        
        (abs(m2_gr_peak) > abs(m2_text_val)) ? ( m2_text_val = m2_gr_peak; m2_txt_timer = floor(fps_ui * 1.0); ) : (
            m2_txt_timer -= 1; (m2_txt_timer <= 0) ? ( m2_text_val = m2_gr_peak; m2_txt_timer = floor(fps_ui * 1.0); );
        );
    );

    (m2_env_in < cfg_hide_env_lin && m2_engine_mode != -1) ? (
        m2_silence_timer += 1;
        (m2_silence_timer > fps_ui * 0.5) ? ( (m2_engine_mode != 2) ? m2_text_val = 0; );
    ) : ( m2_silence_timer = 0; );
);


// ==========================================================
// METER 3 (PRE Out LEVEL) (Channels 13/14)
// ==========================================================
m3_raw = max(abs(spl12), abs(spl13));

// 1. Catch 50ms absolute peak for digital LED meters
m3_disp_peak = max(m3_disp_peak, m3_raw); 

// 2. Calculate EMA RMS (300ms) for analog meters
m3_sq = m3_raw * m3_raw;
m3_rms_sq += (m3_sq - m3_rms_sq) * rms_ema_coeff;
m3_rms_val = sqrt(max(0, m3_rms_sq));

// ==========================================================
// AUTO GAIN COMPENSATOR (Adaptive LUFS Engine)
// ==========================================================

//  Read speed factor from Lua (e.g. 0.25, 0.5, 1.0, 2.0, 4.0)
spd_factor = gmem[local_base + 337];
(spd_factor <= 0) ? spd_factor = 1.0;

// refresh coefficients only if values change in the menu!
(spd_factor != last_spd_factor) ? (
    eff_ema_ms  = 120.0  * spd_factor; // LUFS window
    eff_slow_ms = 600.0 * spd_factor; // Slow smoothing
    eff_fast_ms = 40.0  * spd_factor; // Fast capture smoothing
  
    ag_ema_coeff  = 1.0 - exp(-1.0 / (s_rate * (eff_ema_ms / 1000.0)));
    ag_coeff_slow = 1.0 - exp(-1.0 / (s_rate * (eff_slow_ms / 1000.0)));
    ag_coeff_fast = 1.0 - exp(-1.0 / (s_rate * (eff_fast_ms / 1000.0)));
    
    last_spd_factor = spd_factor;
);

// --- RESTORE AUTO GAIN MATH STATE FROM LUA ---
(gmem[local_base + 339] > 0) ? (
    ag_current_gain = gmem[local_base + 339];
    ag_target_gain = ag_current_gain;
    gmem[local_base + 339] = 0; // Acknowledge and clear
);

// Check if Auto Gain is enabled and if HOLD is active
ag_enabled = (gmem[local_base + 78] > 0.5) ? 1 : 0; 
ag_hold = (gmem[local_base + 79] > 0.5) ? 1 : 0;

// --- Detect UI Toggles for Re-learn ---
(ag_enabled == 1 && ag_last_enabled == 0) ? (
    ag_initialized = 0; // Force warm init on power ON
);
(ag_hold == 0 && ag_last_hold == 1) ? (
    ag_initialized = 0; // Force warm init when un-freezing
);

ag_last_enabled = ag_enabled;
ag_last_hold = ag_hold;

ag_enabled == 1 ? (
    
    is_playing_now = (play_state & 1);

    // K-weighting and math is bypassed completely if HOLD is active!
    (is_playing_now && ag_hold == 0) ? (
        ag_ref_L = spl12; ag_ref_R = spl13; 
        ag_out_L = spl0;  ag_out_R = spl1;  
        
        // --- STAGE 1: High Pass Filter ---
        hp_ref_L = hp_b0 * ag_ref_L + hp_b1 * hp_ref_L_z1 + hp_b2 * hp_ref_L_z2 - hp_a1 * hp_ref_L_y1 - hp_a2 * hp_ref_L_y2;
        hp_ref_L_z2 = hp_ref_L_z1; hp_ref_L_z1 = ag_ref_L; hp_ref_L_y2 = hp_ref_L_y1; hp_ref_L_y1 = hp_ref_L;

        hp_ref_R = hp_b0 * ag_ref_R + hp_b1 * hp_ref_R_z1 + hp_b2 * hp_ref_R_z2 - hp_a1 * hp_ref_R_y1 - hp_a2 * hp_ref_R_y2;
        hp_ref_R_z2 = hp_ref_R_z1; hp_ref_R_z1 = ag_ref_R; hp_ref_R_y2 = hp_ref_R_y1; hp_ref_R_y1 = hp_ref_R;

        hp_out_L = hp_b0 * ag_out_L + hp_b1 * hp_out_L_z1 + hp_b2 * hp_out_L_z2 - hp_a1 * hp_out_L_y1 - hp_a2 * hp_out_L_y2;
        hp_out_L_z2 = hp_out_L_z1; hp_out_L_z1 = ag_out_L; hp_out_L_y2 = hp_out_L_y1; hp_out_L_y1 = hp_out_L;

        hp_out_R = hp_b0 * ag_out_R + hp_b1 * hp_out_R_z1 + hp_b2 * hp_out_R_z2 - hp_a1 * hp_out_R_y1 - hp_a2 * hp_out_R_y2;
        hp_out_R_z2 = hp_out_R_z1; hp_out_R_z1 = ag_out_R; hp_out_R_y2 = hp_out_R_y1; hp_out_R_y1 = hp_out_R;

        // --- STAGE 2: Peaking EQ 1 (1450 Hz) ---
        pk1_ref_L = pk1_b0 * hp_ref_L + pk1_b1 * pk1_ref_L_z1 + pk1_b2 * pk1_ref_L_z2 - pk1_a1 * pk1_ref_L_y1 - pk1_a2 * pk1_ref_L_y2;
        pk1_ref_L_z2 = pk1_ref_L_z1; pk1_ref_L_z1 = hp_ref_L; pk1_ref_L_y2 = pk1_ref_L_y1; pk1_ref_L_y1 = pk1_ref_L;

        pk1_ref_R = pk1_b0 * hp_ref_R + pk1_b1 * pk1_ref_R_z1 + pk1_b2 * pk1_ref_R_z2 - pk1_a1 * pk1_ref_R_y1 - pk1_a2 * pk1_ref_R_y2;
        pk1_ref_R_z2 = pk1_ref_R_z1; pk1_ref_R_z1 = hp_ref_R; pk1_ref_R_y2 = pk1_ref_R_y1; pk1_ref_R_y1 = pk1_ref_R;

        pk1_out_L = pk1_b0 * hp_out_L + pk1_b1 * pk1_out_L_z1 + pk1_b2 * pk1_out_L_z2 - pk1_a1 * pk1_out_L_y1 - pk1_a2 * pk1_out_L_y2;
        pk1_out_L_z2 = pk1_out_L_z1; pk1_out_L_z1 = hp_out_L; pk1_out_L_y2 = pk1_out_L_y1; pk1_out_L_y1 = pk1_out_L;

        pk1_out_R = pk1_b0 * hp_out_R + pk1_b1 * pk1_out_R_z1 + pk1_b2 * pk1_out_R_z2 - pk1_a1 * pk1_out_R_y1 - pk1_a2 * pk1_out_R_y2;
        pk1_out_R_z2 = pk1_out_R_z1; pk1_out_R_z1 = hp_out_R; pk1_out_R_y2 = pk1_out_R_y1; pk1_out_R_y1 = pk1_out_R;

        // --- STAGE 3: Peaking EQ 2 (3500 Hz) ---
        pk2_ref_L = pk2_b0 * pk1_ref_L + pk2_b1 * pk2_ref_L_z1 + pk2_b2 * pk2_ref_L_z2 - pk2_a1 * pk2_ref_L_y1 - pk2_a2 * pk2_ref_L_y2;
        pk2_ref_L_z2 = pk2_ref_L_z1; pk2_ref_L_z1 = pk1_ref_L; pk2_ref_L_y2 = pk2_ref_L_y1; pk2_ref_L_y1 = pk2_ref_L;

        pk2_ref_R = pk2_b0 * pk1_ref_R + pk2_b1 * pk2_ref_R_z1 + pk2_b2 * pk2_ref_R_z2 - pk2_a1 * pk2_ref_R_y1 - pk2_a2 * pk2_ref_R_y2;
        pk2_ref_R_z2 = pk2_ref_R_z1; pk2_ref_R_z1 = pk1_ref_R; pk2_ref_R_y2 = pk2_ref_R_y1; pk2_ref_R_y1 = pk2_ref_R;

        pk2_out_L = pk2_b0 * pk1_out_L + pk2_b1 * pk2_out_L_z1 + pk2_b2 * pk2_out_L_z2 - pk2_a1 * pk2_out_L_y1 - pk2_a2 * pk2_out_L_y2;
        pk2_out_L_z2 = pk2_out_L_z1; pk2_out_L_z1 = pk1_out_L; pk2_out_L_y2 = pk2_out_L_y1; pk2_out_L_y1 = pk2_out_L;

        pk2_out_R = pk2_b0 * pk1_out_R + pk2_b1 * pk2_out_R_z1 + pk2_b2 * pk2_out_R_z2 - pk2_a1 * pk2_out_R_y1 - pk2_a2 * pk2_out_R_y2;
        pk2_out_R_z2 = pk2_out_R_z1; pk2_out_R_z1 = pk1_out_R; pk2_out_R_y2 = pk2_out_R_y1; pk2_out_R_y1 = pk2_out_R;

        // --- STAGE 4: High Shelf (4700 Hz) ---
        fm_ref_L = hs_b0 * pk2_ref_L + hs_b1 * hs_ref_L_z1 + hs_b2 * hs_ref_L_z2 - hs_a1 * hs_ref_L_y1 - hs_a2 * hs_ref_L_y2;
        hs_ref_L_z2 = hs_ref_L_z1; hs_ref_L_z1 = pk2_ref_L; hs_ref_L_y2 = hs_ref_L_y1; hs_ref_L_y1 = fm_ref_L;

        fm_ref_R = hs_b0 * pk2_ref_R + hs_b1 * hs_ref_R_z1 + hs_b2 * hs_ref_R_z2 - hs_a1 * hs_ref_R_y1 - hs_a2 * hs_ref_R_y2;
        hs_ref_R_z2 = hs_ref_R_z1; hs_ref_R_z1 = pk2_ref_R; hs_ref_R_y2 = hs_ref_R_y1; hs_ref_R_y1 = fm_ref_R;

        fm_out_L = hs_b0 * pk2_out_L + hs_b1 * hs_out_L_z1 + hs_b2 * hs_out_L_z2 - hs_a1 * hs_out_L_y1 - hs_a2 * hs_out_L_y2;
        hs_out_L_z2 = hs_out_L_z1; hs_out_L_z1 = pk2_out_L; hs_out_L_y2 = hs_out_L_y1; hs_out_L_y1 = fm_out_L;

        fm_out_R = hs_b0 * pk2_out_R + hs_b1 * hs_out_R_z1 + hs_b2 * hs_out_R_z2 - hs_a1 * hs_out_R_y1 - hs_a2 * hs_out_R_y2;
        hs_out_R_z2 = hs_out_R_z1; hs_out_R_z1 = pk2_out_R; hs_out_R_y2 = hs_out_R_y1; hs_out_R_y1 = fm_out_R;
        
        // --- BS.1770 POWER CALCULATION (Total Energy over F-M Weighting) ---
        p_ref = (fm_ref_L * fm_ref_L) + (fm_ref_R * fm_ref_R);
        p_out = (fm_out_L * fm_out_L) + (fm_out_R * fm_out_R);
        
        ag_freeze_power = 0.00000001; 

        // --- Fast Envelope for Gate ---
        ag_fast_env += (p_ref - ag_fast_env) * gate_env_coeff;
        ag_gate_open = (ag_fast_env > ag_gate_power);

        (p_ref > ag_freeze_power && p_out > ag_freeze_power && (ag_initialized == 0 || ag_gate_open)) ? (
            
            // WARM INITIALIZATION: Instant snap on first sample
            (ag_initialized == 0 || ag_ref_power_env < ag_freeze_power) ? (
                ag_ref_power_env = p_ref;
                ag_out_power_env = p_out;
                ag_initialized = 1;
            ) : (
                ag_ref_power_env += (p_ref - ag_ref_power_env) * ag_ema_coeff;
                ag_out_power_env += (p_out - ag_out_power_env) * ag_ema_coeff;
            );
            
            (ag_ref_power_env > 0.000000001 && ag_out_power_env > 0.000000001) ? (
                ag_target_gain = sqrt(ag_ref_power_env / ag_out_power_env);
                ag_target_gain = max(0.125, min(4.0, ag_target_gain)); // -18 dB to +12 dB bounds
            );
        );
    );

    // Smoothing is also bypassed when HOLD is active to keep gain frozen
    (ag_hold == 0) ? (
        // --- Adaptive Delta-Scaled Smoothing (dB Domain) ---
        ag_target_db_math = 20 * log10(max(0.000000001, ag_target_gain));
        ag_current_db_math = 20 * log10(max(0.000000001, ag_current_gain));
        
        ag_delta_db = abs(ag_target_db_math - ag_current_db_math);
        ag_factor = min(1.0, ag_delta_db / 2.0); 
        
        ag_current_coeff = ag_coeff_slow + (ag_coeff_fast - ag_coeff_slow) * ag_factor;
        ag_current_gain += (ag_target_gain - ag_current_gain) * ag_current_coeff; 
    );
    
    spl0 *= ag_current_gain;
    spl1 *= ag_current_gain;

) : (
    // AG DISABLED (PURE BYPASS)
    0; 
);


// Diagnostic LUFS values (-0.691 dB offset according to BS.1770 standard)
ag_ui_ref_db = (ag_ref_power_env > 0.000000001) ? (10 * log10(ag_ref_power_env) - 0.691) : -144.0;
ag_ui_out_db = (ag_out_power_env > 0.000000001) ? (10 * log10(ag_out_power_env) - 0.691) : -144.0;
ag_ui_target_db = 20 * log10(max(0.000000001, ag_target_gain));
ag_ui_gain_db = ag_enabled ? 20 * log10(max(0.000000001, ag_current_gain)) : 0.0;
ag_ui_comp_db = ag_ui_out_db + ag_ui_gain_db;



// ==========================================================
// METER 4 (CHAIN Out LEVEL) (Channels 1/2)
// ==========================================================
m4_raw = max(abs(spl0), abs(spl1));

// 1. Catch 50ms absolute peak for digital LED meters
m4_disp_peak = max(m4_disp_peak, m4_raw);

// 2. Calculate EMA RMS (300ms) for analog meters
m4_sq = m4_raw * m4_raw;
m4_rms_sq += (m4_sq - m4_rms_sq) * rms_ema_coeff;
m4_rms_val = sqrt(max(0, m4_rms_sq));



// --- Erase internal channels ---
// Note: spl2 in spl3 (Chn 3/4) left for Sidechain!
spl4=0; spl5=0; spl6=0; spl7=0;
spl8=0; spl9=0; spl10=0; spl11=0;
spl12=0; spl13=0;



// ==========================================================
// GMEM WRITE (Continuous output for StripLink & Lua)
// ==========================================================
update_cnt += 1;

(update_cnt >= update_rate && slider1 > 0) ? (
    gmem[local_base + 320] = m1_disp;
    gmem[local_base + 321] = m1_text_val;
    gmem[local_base + 322] = m2_disp;
    gmem[local_base + 323] = m2_text_val;
    
    // --- METER 3 (PRE Out) ---
    gmem[local_base + 324] = m3_disp_peak; // Absolute 50ms peak for Digital
    gmem[local_base + 325] = m3_rms_val;   // 300ms RMS for Analog (reused text slot)
    
    gmem[local_base + 326] = m1_all_time_max;
    gmem[local_base + 327] = m2_all_time_max;
    gmem[local_base + 328] = m1_engine_mode; 
    gmem[local_base + 329] = m2_engine_mode;
    
    // --- METER 4 (CHAIN Out) ---
    gmem[local_base + 334] = m4_disp_peak; // Absolute 50ms peak for Digital
    gmem[local_base + 335] = m4_rms_val;   // 300ms RMS for Analog (newly allocated)
    
    // Reset peak windows for the next 50 ms cycle!
    m3_disp_peak = 0;
    m4_disp_peak = 0;
    
    gmem[local_base + 338] = ag_current_gain;
 
    update_cnt = 0;
);

// ==========================================================
// GFX - DUAL COMPRESSOR & AUTO GAIN UI
// ==========================================================
@gfx 480 470

// --- GLOBAL HEADER ---
gfx_setfont(1, "Arial", 14, 'b');
gfx_r = 0.9; gfx_g = 0.9; gfx_b = 0.9; 
gfx_x = 20; gfx_y = 12;
gfx_printf("STRIPLINK AGGREGATOR - METERING");

// ==========================================================
// METER 1 (COMP / GATE / EXP 1)
// ==========================================================
gfx_r = 0.4; gfx_g = 0.4; gfx_b = 0.4;
gfx_line(20, 30, 460, 30);

gfx_setfont(1, "Arial", 14, 'b');
gfx_r = 1; gfx_g = 0.8; gfx_b = 0.1;
gfx_x = 20; gfx_y = 40;
gfx_printf("DYN 1 (METER 1)");

gfx_setfont(1, "Arial", 12);
gfx_x = 20; gfx_y = 60;

(m1_engine_mode == -1) ? (
    gfx_r = 0; gfx_g = 0.8; gfx_b = 1; gfx_printf("ENGINE: NATIVE DAW GR");
) : (m1_engine_mode == 2) ? (
    gfx_r = 0.8; gfx_g = 0.2; gfx_b = 1; gfx_printf("ENGINE: GATE");
) : (m1_engine_mode == 3) ? (
    gfx_r = 1; gfx_g = 0.5; gfx_b = 0; gfx_printf("ENGINE: EXPANDER");
) : (
    gfx_r = 0; gfx_g = 1; gfx_b = 0; gfx_printf("ENGINE: COMPRESSOR");
);

// Opcijski dodatek: Izpišemo "AUTO: " če je v avto načinu
(slider2 == 0) ? (
    gfx_x = 240; gfx_y = 60;
    gfx_r = 1; gfx_g = 1; gfx_b = 1;
    gfx_printf("[ AUTO DETECT ON ]");
);

gfx_x = 20; gfx_y = 75;
(m1_engine_mode != 2 && m1_engine_mode >= 0) ? (
    (m1_bucket_state == 0) ? ( gfx_r=0.5; gfx_g=0.5; gfx_b=0.5; gfx_printf("STATE: IDLE / SILENCE"); );
    (m1_bucket_state == 1) ? ( gfx_r=0; gfx_g=1; gfx_b=0; gfx_printf("STATE: FILLING"); );
    (m1_bucket_state == 2) ? ( gfx_r=1; gfx_g=0.2; gfx_b=0.2; gfx_printf("STATE: DRAINING"); );
    (m1_bucket_state == 3) ? ( gfx_r=0; gfx_g=0.5; gfx_b=1; gfx_printf("STATE: FROZEN (Below Floor)"); );
) : (m1_engine_mode == 2) ? (
    gfx_r=0.8; gfx_g=0.2; gfx_b=1; gfx_printf("STATE: GATE ACTIVE");
);

// Show Floor & MUG only for Comp Modes
(m1_engine_mode != 2 && m1_engine_mode >= 0) ? (
    gfx_r = 0.8; gfx_g = 0.8; gfx_b = 0.8;
    gfx_x = 20; gfx_y = 95;
    gfx_printf("DYNAMIC FLOOR: %.1f dB", m1_dyn_min_vol);

    gfx_setfont(1, "Arial", 14);
    gfx_r = 0; gfx_g = 1; gfx_b = 0; 
    gfx_x = 20; gfx_y = 115;
    gfx_printf("CAPTURED MUG: %.2f dB", m1_captured_mug);

    // Bucket & Drift (Aligned to the right)
    gfx_setfont(1, "Arial", 12);
    gfx_r = 1; gfx_g = 1; gfx_b = 0;
    
// Prikaz KINK pospeška namesto starega drifta
    gfx_x = 240; gfx_y = 95;
        gfx_printf("ACCEL PEAK: %.5f", m1_debug_accel);
        
        gfx_x = 240; gfx_y = 107;
        gfx_printf("THR: %.5f", kink_sens);
    
        gfx_x = 240; gfx_y = 119;
        (m1_ui_flash > 0) ? (
            gfx_r=0.2; gfx_g=1.0; gfx_b=0.2; // Svetlo zelena
            gfx_printf("[ CAPTURED ]");
        ) : (
            gfx_r=0.4; gfx_g=0.4; gfx_b=0.4; // Temno siva
            gfx_printf("[ WAITING... ]");
        );
);

gfx_setfont(1, "Arial", 16);
gfx_r = 1; gfx_g = 0.2; gfx_b = 0.2; 
gfx_x = 20; gfx_y = 140;
gfx_printf("ATT 1: %.2f dB", - m1_text_val);

gr1_width = min(440, abs(m1_disp) * 15); 
gfx_rect(20, 160, gr1_width, 12);


// ==========================================================
// METER 2 (COMP / GATE / EXP 2)
// ==========================================================
gfx_r = 0.4; gfx_g = 0.4; gfx_b = 0.4;
gfx_line(20, 185, 460, 185);

gfx_setfont(1, "Arial", 14, 'b');
gfx_r = 1; gfx_g = 0.8; gfx_b = 0.1;
gfx_x = 20; gfx_y = 195;
gfx_printf("DYN 2 (METER 2)");

gfx_setfont(1, "Arial", 12);
gfx_x = 20; gfx_y = 215;

(m2_engine_mode == -1) ? (
    gfx_r = 0; gfx_g = 0.8; gfx_b = 1; gfx_printf("ENGINE: NATIVE DAW GR");
) : (m2_engine_mode == 2) ? (
    gfx_r = 0.8; gfx_g = 0.2; gfx_b = 1; gfx_printf("ENGINE: GATE");
) : (m2_engine_mode == 3) ? (
    gfx_r = 1; gfx_g = 0.5; gfx_b = 0; gfx_printf("ENGINE: EXPANDER");
) : (
    gfx_r = 0; gfx_g = 1; gfx_b = 0; gfx_printf("ENGINE: COMPRESSOR");
);

// Izpis "AUTO" če je avtomatika vklopljena na Metru 2
(slider3 == 0) ? (
    gfx_x = 240; gfx_y = 215;
    gfx_r = 1; gfx_g = 1; gfx_b = 1;
    gfx_printf("[ AUTO DETECT ON ]");
);

gfx_x = 20; gfx_y = 230;

(m2_engine_mode != 2 && m2_engine_mode >= 0) ? (
    (m2_bucket_state == 0) ? ( gfx_r=0.5; gfx_g=0.5; gfx_b=0.5; gfx_printf("STATE: IDLE / SILENCE"); );
    (m2_bucket_state == 1) ? ( gfx_r=0; gfx_g=1; gfx_b=0; gfx_printf("STATE: FILLING"); );
    (m2_bucket_state == 2) ? ( gfx_r=1; gfx_g=0.2; gfx_b=0.2; gfx_printf("STATE: DRAINING"); );
    (m2_bucket_state == 3) ? ( gfx_r=0; gfx_g=0.5; gfx_b=1; gfx_printf("STATE: FROZEN (Below Floor)"); );
) : (m2_engine_mode == 2) ? (
    gfx_r=0.8; gfx_g=0.2; gfx_b=1; gfx_printf("STATE: GATE ACTIVE");
);

// Show Floor & MUG only for Comp/Exp Modes
(m2_engine_mode != 2 && m2_engine_mode >= 0) ? (
    gfx_r = 0.8; gfx_g = 0.8; gfx_b = 0.8;
    gfx_x = 20; gfx_y = 250;
    gfx_printf("DYNAMIC FLOOR: %.1f dB", m2_dyn_min_vol);

    gfx_setfont(1, "Arial", 14);
    gfx_r = 0; gfx_g = 1; gfx_b = 0; 
    gfx_x = 20; gfx_y = 270;
    gfx_printf("CAPTURED MUG: %.2f dB", m2_captured_mug);
    
    // Prikaz KINK pospeška za Meter 2
    gfx_setfont(1, "Arial", 12);
    gfx_r = 1; gfx_g = 1; gfx_b = 0;
    
    gfx_x = 240; gfx_y = 250;
    gfx_printf("ACCEL PEAK: %.5f", m2_debug_accel);
    
    gfx_x = 240; gfx_y = 262;
    gfx_printf("THR: %.5f", kink_sens_2);
    
    gfx_x = 240; gfx_y = 274;
    (m2_ui_flash > 0) ? (
        gfx_r=0.2; gfx_g=1.0; gfx_b=0.2;
        gfx_printf("[ CAPTURED ]");
    ) : (
        gfx_r=0.4; gfx_g=0.4; gfx_b=0.4;
        gfx_printf("[ WAITING... ]");
    );
);

gfx_setfont(1, "Arial", 16);
gfx_r = 1; gfx_g = 0.2; gfx_b = 0.2; 
gfx_x = 20; gfx_y = 295;

// --- POPRAVEK: Absolutna vrednost za Gate izpis ---
(m2_engine_mode == 2) ? (
    gfx_printf("ATT 2: %.2f dB", abs(m2_text_val));
) : (
    gfx_printf("ATT 2: %.2f dB", m2_text_val);
);

gr2_width = min(440, abs(m2_disp) * 15); 
gfx_rect(20, 315, gr2_width, 12);


// ==========================================================
// AUTO GAIN OUTPUT
// ==========================================================
gfx_r = 0.4; gfx_g = 0.4; gfx_b = 0.4;
gfx_line(20, 340, 460, 340);

gfx_setfont(1, "Arial", 14, 'b');
gfx_r = 0.2; gfx_g = 0.8; gfx_b = 1.0;
gfx_x = 20; gfx_y = 350;  
gfx_printf("AUTO GAIN DIAGNOSTIC");

gfx_setfont(1, "Arial", 12);
gfx_r = 0.8; gfx_g = 0.8; gfx_b = 0.8;

gfx_x = 20; gfx_y = 370;
ui_local_base = gmem[100000] + slider1 * 500;
ui_ag_enabled = (gmem[ui_local_base + 78] > 0.5) ? 1 : 0;
gfx_printf("STATUS: %s", (ui_ag_enabled ? "ON" : "OFF"));

gfx_x = 20; gfx_y = 385;
gfx_printf("REF IN (Ch 13/14): %.1f dB", ag_ui_ref_db);

gfx_x = 20; gfx_y = 400;
gfx_printf("RAW OUT (Ch 1/2): %.1f dB", ag_ui_out_db);

gfx_r = 1.0; gfx_g = 0.5; gfx_b = 0.2;
gfx_x = 20; gfx_y = 415;
gfx_printf("TARGET MATH: %+.2f dB", ag_ui_target_db);

gfx_r = 1.0; gfx_g = 1.0; gfx_b = 0.2;
gfx_x = 20; gfx_y = 430;
gfx_printf("APPLIED GAIN: %+.2f dB", ag_ui_gain_db);

gfx_r = 0.2; gfx_g = 1.0; gfx_b = 0.2;
gfx_setfont(1, "Arial", 14, 'b');
gfx_x = 20; gfx_y = 445;
gfx_printf("COMPENSATED: %.1f dB", ag_ui_comp_db);



