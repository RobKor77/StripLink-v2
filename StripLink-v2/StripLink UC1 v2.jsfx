    dbg_i = 0;
    while (dbg_i < dna_len) (
        gfx_printf("%d ", dna_local_buf[dbg_i]);
        dbg_i += 1;
        
        (dbg_i % 5 == 0) ? (
            gfx_y += 12;
            gfx_x = 5;
        );
    );
) : (
    gfx_printf("RAW: EMPTY");
);
