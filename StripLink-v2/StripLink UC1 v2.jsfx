desc:StripLink UC1 v2
options:gmem=striplink_v2.0

num_inputs = 14;
num_outputs = 2;

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

// =========================================================================
// SYSTEM & UTILITY (1 - 12)
// =========================================================================
slider1:0<0,1000000,1>-Instance Hash (Internal)
slider2:0<0,1000,1>-AssignedSlot (Internal)
slider3:0<0,4294967295,1>-Instance GUID Hash (Internal)
slider4:0<0,3,1>-Local TAB (MIDI)
slider5:0<0,3,1>-Global TAB (MIDI)
slider6:0<0,999,1>-TAB Colors (Internal)
slider7:2236962<0,4294967295,1>-Layout Color EQ (Internal)
slider8:2236962<0,4294967295,1>-Layout Color DYN (Internal)
slider9:2236962<0,4294967295,1>-Layout Color FX (Internal)
slider10:0<-12,12,0.1>-Input Gain (MIDI)
slider11:1<0,1,1>-Auto Gain Power (MIDI)
slider12:0<0,1,1>-Auto Gain Freeze (MIDI)

// =========================================================================
// TAB 1: EQ (13 - 32) -> 12 Knobs, 8 Switches
// =========================================================================
slider13:.5<0,1,.01>-Macro 1 (EQ)
slider14:.5<0,1,.01>-Macro 2 (EQ)
slider15:.5<0,1,.01>-Macro 3 (EQ)
slider16:.5<0,1,.01>-Macro 4 (EQ)
slider17:.5<0,1,.01>-Macro 5 (EQ)
slider18:.5<0,1,.01>-Macro 6 (EQ)
slider19:.5<0,1,.01>-Macro 7 (EQ)
slider20:.5<0,1,.01>-Macro 8 (EQ)
slider21:.5<0,1,.01>-Macro 9 (EQ)
slider22:.5<0,1,.01>-Macro 10 (EQ)
slider23:.5<0,1,.01>-Macro 11 (EQ)
slider24:.5<0,1,.01>-Macro 12 (EQ)
slider25:1<0,1,1>-Switch 1 (EQ)
slider26:0<0,1,1>-Switch 2 (EQ)
slider27:0<0,1,1>-Switch 3 (EQ)
slider28:0<0,1,1>-Switch 4 (EQ)
slider29:0<0,1,1>-Switch 5 (EQ)
slider30:0<0,1,1>-Switch 6 (EQ)
slider31:0<0,1,1>-Switch 7 (EQ)
slider32:0<0,1,1>-Switch 8 (EQ)

// =========================================================================
// TAB 2: DYN 1 - TOP (33 - 41) -> 5 Knobs, 4 Switches
// =========================================================================
slider33:.5<0,1,.01>-Macro 13 (DYN 1)
slider34:.5<0,1,.01>-Macro 14 (DYN 1)
slider35:.5<0,1,.01>-Macro 15 (DYN 1)
slider36:.5<0,1,.01>-Macro 16 (DYN 1)
slider37:.5<0,1,.01>-Macro 17 (DYN 1)
slider38:1<0,1,1>-Switch 9 (DYN 1)
slider39:0<0,1,1>-Switch 10 (DYN 1)
slider40:0<0,1,1>-Switch 11 (DYN 1)
slider41:0<0,1,1>-Switch 12 (DYN 1)

// =========================================================================
// TAB 2: DYN 2 - BOTTOM (42 - 50) -> 5 Knobs, 4 Switches
// =========================================================================
slider42:.5<0,1,.01>-Macro 18 (DYN 2)
slider43:.5<0,1,.01>-Macro 19 (DYN 2)
slider44:.5<0,1,.01>-Macro 20 (DYN 2)
slider45:.5<0,1,.01>-Macro 21 (DYN 2)
slider46:.5<0,1,.01>-Macro 22 (DYN 2)
slider47:1<0,1,1>-Switch 13 (DYN 2)
slider48:0<0,1,1>-Switch 14 (DYN 2)
slider49:0<0,1,1>-Switch 15 (DYN 2)
slider50:0<0,1,1>-Switch 16 (DYN 2)

// =========================================================================
// TAB 3: FX PRE - TOP (51 - 56) -> 3 Knobs, 3 Switches
// =========================================================================
slider51:.5<0,1,.01>-Macro 23 (FX PRE)
slider52:.5<0,1,.01>-Macro 24 (FX PRE)
slider53:.5<0,1,.01>-Macro 25 (FX PRE)
slider54:.5<0,1,.01>-Macro 26 (FX PRE)
slider55:1<0,1,1>-Switch 17 (FX PRE)
slider56:0<0,1,1>-Switch 18 (FX PRE)

// =========================================================================
// TAB 3: FX POST - BOTTOM (57 - 68) -> 9 Knobs, 3 Switches
// =========================================================================
slider57:.5<0,1,.01>-Macro 26 (FX POST)
slider58:.5<0,1,.01>-Macro 27 (FX POST)
slider59:.5<0,1,.01>-Macro 28 (FX POST)
slider60:.5<0,1,.01>-Macro 29 (FX POST)
slider61:.5<0,1,.01>-Macro 30 (FX POST)
slider62:.5<0,1,.01>-Macro 31 (FX POST)
slider63:.5<0,1,.01>-Macro 32 (FX POST)
slider64:.5<0,1,.01>-Macro 33 (FX POST)
slider65:.5<0,1,.01>-Macro 34 (FX POST)
slider66:0<0,1,1>-Switch 20 (FX POST)
