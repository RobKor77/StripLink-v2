// Shortcut for testing layout builder .............
// SHIFT in ALT or lefr clikc anywhere on empty bg
(leftMouse && !lastLeftMouse && shiftDown && altDown && !is_hover_tab && current_dragging == 0) ? (
    gmem[base + 428] = (gmem[base + 428] == 0) ? 1 : 0; // revert mode!
    g_consumed = 1;
);


show_tooltip = 0; 
was_dragging = current_dragging;
); 

